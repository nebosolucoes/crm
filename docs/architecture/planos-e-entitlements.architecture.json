{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Planos e entitlements — o que a organização pode usar, decidido num lugar só",
    "subtitle": "plano é dado (tabela), recurso é código (vocabulário), entitlement é a resposta (uma função SQL); channels nunca desliga; o usuário ainda precisa do papel",
    "output": "planos-e-entitlements.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "admin",
      "label": "Plataforma (quem vende)"
    },
    {
      "id": "tenant",
      "label": "O que o cliente vê"
    },
    {
      "id": "borda",
      "label": "Borda HTTP e páginas"
    },
    {
      "id": "regra",
      "label": "Vocabulário e resolução"
    },
    {
      "id": "gasta",
      "label": "Quem executa em background"
    },
    {
      "id": "dados",
      "label": "Banco"
    },
    {
      "id": "volta",
      "label": "O laço de retorno"
    }
  ],
  "mainPath": [
    "tab-plano",
    "rota-admin-plan",
    "fn-definir-plano",
    "organizations",
    "fn-entitlements",
    "require-role",
    "audit"
  ],
  "nodes": [
    {
      "id": "planos-admin",
      "lane": "admin",
      "col": 1,
      "type": "frontend",
      "label": "/admin/planos e /admin/planos/[id]",
      "sublabel": "criar, editar, ativar/desativar; checkbox de channels travado"
    },
    {
      "id": "tab-plano",
      "lane": "admin",
      "col": 2,
      "type": "frontend",
      "label": "Aba Plano em /admin/tenants/[id]",
      "sublabel": "trocar plano com motivo · overrides com validade · tabela plano | override | efetivo"
    },
    {
      "id": "form-tenant",
      "lane": "admin",
      "col": 3,
      "type": "frontend",
      "label": "/admin/tenants/new",
      "sublabel": "select de planos ativos substitui o enum morto de settings.plan"
    },
    {
      "id": "sidebar",
      "lane": "tenant",
      "col": 1,
      "type": "frontend",
      "label": "Sidebar · hubs · ⌘K",
      "sublabel": "projeções de NAV_CATALOG filtradas por GRUPO_PARA_RECURSO — não decidem, desenham"
    },
    {
      "id": "billing",
      "lane": "tenant",
      "col": 2,
      "type": "frontend",
      "label": "/app/settings/billing",
      "sublabel": "plano atual, recursos, overrides com 'até dd/mm'"
    },
    {
      "id": "indisponivel",
      "lane": "tenant",
      "col": 3,
      "type": "frontend",
      "label": "/app/recurso-indisponivel",
      "sublabel": "destino do redirect de exigirRecurso(); nome leigo do recurso"
    },
    {
      "id": "central",
      "lane": "tenant",
      "col": 4,
      "type": "frontend",
      "label": "Central de avisos",
      "sublabel": "kind entitlement_changed: plano trocado, recurso liberado até X, execução pulada"
    },
    {
      "id": "rota-admin-plans",
      "lane": "borda",
      "col": 1,
      "type": "api",
      "label": "GET/POST /api/v1/admin/plans · PATCH /[id]",
      "sublabel": "requirePlatformAdmin + Zod + Idempotency-Key + audit"
    },
    {
      "id": "rota-admin-plan",
      "lane": "borda",
      "col": 2,
      "type": "api",
      "label": "PUT /api/v1/admin/tenants/[id]/plan · POST/DELETE …/overrides",
      "sublabel": "chama a RPC com o client de SESSÃO — o banco confere fn_is_platform_admin()"
    },
    {
      "id": "require-role",
      "lane": "borda",
      "col": 3,
      "type": "service",
      "label": "requireRole({ feature }) · resolveAuthDual",
      "sublabel": "papel do banco → MFA → entitlement; falta → 403 feature_not_entitled"
    },
    {
      "id": "exigir-recurso",
      "lane": "borda",
      "col": 4,
      "type": "service",
      "label": "exigirRecurso() nas páginas",
      "sublabel": "cerca: toda page.tsx de destino vendável chama, ou justifica na allowlist"
    },
    {
      "id": "mcp",
      "lane": "borda",
      "col": 5,
      "type": "api",
      "label": "/api/mcp",
      "sublabel": "cada tool declara recurso no catálogo; server.ts recusa antes de executar"
    },
    {
      "id": "recursos",
      "lane": "regra",
      "col": 1,
      "type": "service",
      "label": "lib/entitlements/recursos.ts",
      "sublabel": "RECURSOS · RECURSOS_VENDAVEIS · GRUPO_PARA_RECURSO · recursoDoDestino — client-safe"
    },
    {
      "id": "limites",
      "lane": "regra",
      "col": 2,
      "type": "service",
      "label": "lib/entitlements/limites.ts",
      "sublabel": "chaves, schema Zod, mescla por chave; enforced:false até a etapa 8"
    },
    {
      "id": "tipos",
      "lane": "regra",
      "col": 3,
      "type": "service",
      "label": "lib/entitlements/tipos.ts",
      "sublabel": "lerEntitlements (tolerante) · temRecurso — channels curto-circuita"
    },
    {
      "id": "resolver",
      "lane": "regra",
      "col": 4,
      "type": "service",
      "label": "resolver.ts (Supabase, cache por request) · resolver-pg.ts (pool, 60 s)",
      "sublabel": "os dois chamam a MESMA função SQL; erro de RPC lança, nunca vira 'sem recurso'"
    },
    {
      "id": "drain",
      "lane": "gasta",
      "col": 1,
      "type": "worker",
      "label": "drain.ts (enfileira o turno)",
      "sublabel": "sem ai_agents → não cria job, log com motivo"
    },
    {
      "id": "agent-worker",
      "lane": "gasta",
      "col": 2,
      "type": "worker",
      "label": "agent-worker (após o claim)",
      "sublabel": "sem ai_agents → job done com last_error feature_not_entitled — vale para todos os JobKind"
    },
    {
      "id": "broadcast-worker",
      "lane": "gasta",
      "col": 3,
      "type": "worker",
      "label": "lib/agendamentos-grupos/worker.ts",
      "sublabel": "sem broadcast → run skipped feature_not_entitled, relógio avança"
    },
    {
      "id": "automation",
      "lane": "gasta",
      "col": 4,
      "type": "worker",
      "label": "automation engine · follow-up engine",
      "sublabel": "gate por AÇÃO: send_ai_message → ai_agents; mover lead → crm"
    },
    {
      "id": "platform_plans",
      "lane": "dados",
      "col": 1,
      "type": "database",
      "label": "platform_plans",
      "sublabel": "slug, is_active, is_default (único parcial), limits jsonb; RLS: só platform admin lê"
    },
    {
      "id": "plan_features",
      "lane": "dados",
      "col": 2,
      "type": "database",
      "label": "platform_plan_features",
      "sublabel": "(plan_id, feature) — CHECK dos 5 vendáveis; channels NÃO é linha"
    },
    {
      "id": "organizations",
      "lane": "dados",
      "col": 3,
      "type": "database",
      "label": "organizations.plan_id",
      "sublabel": "fonte de verdade da atribuição; trigger BEFORE INSERT põe o padrão"
    },
    {
      "id": "overrides",
      "lane": "dados",
      "col": 4,
      "type": "database",
      "label": "organization_feature_overrides",
      "sublabel": "feature, mode, limits, starts_at, ends_at, revoked_at; CHECK channels nunca disable"
    },
    {
      "id": "fn-entitlements",
      "lane": "dados",
      "col": 5,
      "type": "database",
      "label": "fn_org_entitlements(org) · fn_org_has_feature(org, f)",
      "sublabel": "plano ∪ enable − disable ∪ {channels}; expiração passiva por ends_at"
    },
    {
      "id": "fn-definir-plano",
      "lane": "dados",
      "col": 6,
      "type": "database",
      "label": "fn_definir_plano_da_organizacao · fn_criar/revogar_override",
      "sublabel": "security definer; exigem fn_is_platform_admin() ou service_role; recusam plano inativo"
    },
    {
      "id": "legado",
      "lane": "dados",
      "col": 7,
      "type": "database",
      "label": "plano 'legado' (seed) + backfill",
      "sublabel": "todos os recursos, is_default; toda org existente cai nele — efeito no deploy: zero"
    },
    {
      "id": "audit",
      "lane": "volta",
      "col": 1,
      "type": "database",
      "label": "api_audit_log",
      "sublabel": "plan.* · tenant.plan_changed · tenant.feature_override_* · authz.denied{feature_not_entitled}"
    },
    {
      "id": "runs",
      "lane": "volta",
      "col": 2,
      "type": "frontend",
      "label": "Execuções de IA · Histórico de disparo",
      "sublabel": "o que foi pulado por recurso aparece como linha com motivo, não como ausência"
    },
    {
      "id": "invariantes",
      "lane": "volta",
      "col": 3,
      "type": "service",
      "label": "tests/invariants/entitlements-*",
      "sublabel": "canais-sempre · resolução · RLS entre tenants · paridade CHECK↔TS"
    }
  ],
